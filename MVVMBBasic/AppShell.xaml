<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="MVVMBBasic.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Views"
    Shell.FlyoutBehavior="Flyout">

    <ShellContent
        Title="דף הבית"
        ContentTemplate="{DataTemplate views:WelcomePage}"
        Route="WelcomePage" />

    <ShellContent
        Title="מחשבון פשוט"
        ContentTemplate="{DataTemplate views:CalculatorPage}"
        Route="CalculatorPage" />

    <ShellContent
    Title="מחשבון גיל"
    ContentTemplate="{DataTemplate views:CalcAgePage}"
    Route="CalcAge" />

    <ShellContent
        Title="מחשבון טמפרטורה"
        ContentTemplate="{DataTemplate views:TemperaturePage}"
        Route="TemperaturePage" />


</Shell>
